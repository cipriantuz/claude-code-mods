# Copy to your environment (or your process supervisor's config) for bin/dispatcher.py.
# ntfy server; the public server is used when unset.
NTFY_URL=https://ntfy.example.com
# Your private topic name: long and random, e.g. 24+ random characters.
# Alternatively put it in ~/.claude/approval-channel/topic.txt.
NTFY_TOPIC=replace-with-a-long-random-topic-name
# Optional overrides
# APPROVAL_DIR=~/.claude/approval-channel
# SESSION_STATUS_DIR=~/.claude/session-status
# Python used by the mod to run the dispatcher (default: python)
# APPROVAL_PYTHON=python3
